# ==============================================================================
# Konfigurasi Supabase Hosted
# Salin nilai berikut dari Supabase Dashboard -> Project Settings -> API
# ==============================================================================
# URL instance Supabase Hosted (contoh: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anon / Publishable Key (Aman untuk frontend browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Service Role Key (HANYA digunakan di server/backend & skrip CLI administratif)
# PERINGATAN: JANGAN pernah mengekspos kunci ini ke browser atau prefix NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==============================================================================
# Identitas Aplikasi & Wilayah (1 RW per instalasi)
# Variabel NEXT_PUBLIC_* di-inline pada saat build Next.js (Vercel Build).
# Setiap pembaruan nilai memerlukan build / redeployment ulang agar berlaku pada klien.
# ==============================================================================

# Nama singkat aplikasi (bawaan: "SIPANDU")
NEXT_PUBLIC_APP_NAME="SIPANDU"

# Nomor RW cakupan aplikasi (contoh: "06")
NEXT_PUBLIC_APP_RW="06"

# Nama area atau kelurahan wilayah RW (contoh: "Parakan Saat, Bandung")
NEXT_PUBLIC_APP_AREA_NAME="Parakan Saat, Bandung"

# Nama Kota / Kabupaten wilayah administrasi (contoh: "Kota Bandung")
NEXT_PUBLIC_APP_CITY="Kota Bandung"

# Kontak operasional sekretariat (opsional)
NEXT_PUBLIC_APP_CONTACT_ADDRESS=""
NEXT_PUBLIC_APP_CONTACT_PHONE=""

# ==============================================================================
# Proteksi Pengujian & Seeding
# ==============================================================================
# Daftar Supabase Project Ref yang dilindungi (pisahkan dengan koma).
# Target dalam daftar ini selalu ditolak oleh skrip pengujian maupun seeding.
PROTECTED_SUPABASE_PROJECT_REFS=""

# Persetujuan eksekusi pengujian backend (disetel 'true' saat menjalankan test-backend)
ALLOW_DESTRUCTIVE_TEST=false

# Persetujuan pengujian backend terhadap project Supabase terpisah khusus pengujian
ALLOW_REMOTE_HOSTED_TEST=false
ALLOWED_TEST_PROJECT_REF=""

# Persetujuan pengisian data demo
ALLOW_DEMO_SEED=false
ALLOWED_DEMO_PROJECT_REF=""
