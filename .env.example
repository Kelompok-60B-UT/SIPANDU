# ==============================================================================
# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# Konfigurasi Identitas Aplikasi & Wilayah Deployment (Single-Tenant: 1 RW)
#
# Catatan Teknis:
# Variabel lingkungan yang berawalan `NEXT_PUBLIC_` di-inline oleh Next.js
# pada saat proses build (build time).
# Setiap pembaruan nilai konfigurasi memerlukan proses rebuild / redeployment
# agar berlaku di sisi klien browser.
# ==============================================================================

# Nama singkat aplikasi (default: "SIPANDU")
NEXT_PUBLIC_APP_NAME="SIPANDU"

# Nomor RW cakupan deployment aplikasi (contoh: "06")
NEXT_PUBLIC_APP_RW="06"

# Nama area atau kelurahan wilayah RW (contoh: "Parakan Saat, Bandung")
NEXT_PUBLIC_APP_AREA_NAME="Parakan Saat, Bandung"

# Nama Kota / Kabupaten wilayah administrasi (contoh: "Kota Bandung")
NEXT_PUBLIC_APP_CITY="Kota Bandung"

# Kontak operasional sekretariat (Kosongkan jika belum tersedia; jangan gunakan kontak dummy)
NEXT_PUBLIC_APP_CONTACT_ADDRESS=""
NEXT_PUBLIC_APP_CONTACT_PHONE=""
